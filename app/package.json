{
  "name": "notestar",
  "version": "1.0.0",
  "description": "笔记星图 - AI 驱动的智能笔记管理工具",
  "author": "NoteStar",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "start": "node electron/start.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && node electron/start.cjs --dev\"",
    "electron:build": "vite build && cross-env NODE_OPTIONS= ELECTRON_RUN_AS_NODE= electron-builder --win --x64",
    "release": "vite build && cross-env NODE_OPTIONS= ELECTRON_RUN_AS_NODE= electron-builder --win --x64 --publish always",
    "release:draft": "vite build && cross-env NODE_OPTIONS= ELECTRON_RUN_AS_NODE= electron-builder --win --x64 --publish always",
    "pack": "node ../build/package-release.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^5.0.1",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.notestar.noteanalysis",
    "productName": "笔记星图",
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "YOUR_REPO_NAME",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "electron/transcribe.py"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python"
      },
      {
        "from": "electron/transcribe.py",
        "to": "transcribe.py"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "bin/ffmpeg.exe",
          "bin/ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "笔记星图",
      "differentialPackage": false
    }
  }
}
